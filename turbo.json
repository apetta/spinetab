{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"spinetab#dev": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["build"]
		},
		"e2e": {
			"dependsOn": ["build"],
			"cache": false,
			"passThroughEnv": ["CI", "PLAYWRIGHT_*"]
		},
		"spinetab#e2e": {
			"dependsOn": ["build", "@spinetab/harness#build"],
			"cache": false,
			"passThroughEnv": ["CI", "PLAYWRIGHT_*"]
		},
		"@spinetab/harness#build": {
			"dependsOn": ["spinetab#build"],
			"outputs": ["dist/**"]
		},
		"spinetab#consumers": {
			"dependsOn": ["build"],
			"cache": false,
			"passThroughEnv": ["CI", "PLAYWRIGHT_*", "SPINETAB_*"]
		},
		"spinetab#typecheck": {
			"dependsOn": ["build", "^build"]
		}
	}
}
