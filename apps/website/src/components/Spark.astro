---
interface Props {
	class: string;
	variant?: "one" | "two";
}

const { class: className, variant = "one" } = Astro.props;
const paths = {
	one: "M28 5 Q33 26 35 57 M7 27 Q31 31 58 37 M12 51 Q31 33 51 13 M14 10 Q33 34 50 53",
	two: "M35 7 Q30 29 27 58 M5 35 Q30 30 56 25 M13 14 Q31 32 53 49 M12 51 Q32 33 48 10",
};
const mask = `url("data:image/svg+xml,${encodeURIComponent(
	`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><path d="${paths[variant]}" fill="none" stroke="white" stroke-width="3.5" stroke-linecap="round"/></svg>`,
)}")`;
---

<span
	class:list={["spark", className]}
	data-spotlight
	aria-hidden="true"
	style={{ "--spark-mask": mask }}
>
	<span class="spark-surface">
		<span class="spotlight-highlight"></span>
	</span>
</span>
