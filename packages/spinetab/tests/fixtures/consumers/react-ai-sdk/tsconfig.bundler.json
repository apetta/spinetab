{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": false,
		"noEmit": true,
		"types": ["node"],
		"noUnusedLocals": true
	},
	"include": ["types/check.ts", "types/shared-config.ts"]
}
