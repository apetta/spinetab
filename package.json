{
	"name": "spinetab-workspace",
	"version": "0.0.0",
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"turbo": "2.11.8"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"packageManager": "pnpm@12.14.0",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"check": "biome check . && prettier --check .",
		"check:fix": "biome check --write . && prettier --write .",
		"dev": "turbo run dev",
		"e2e": "turbo run e2e",
		"format": "biome format --write . && prettier --write .",
		"prepare": "husky",
		"test": "turbo run test",
		"typecheck": "turbo run typecheck"
	},
	"type": "module"
}
